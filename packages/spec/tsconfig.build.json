{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Runs in any JavaScript runtime (decision 0005): web-platform globals only, no Node types.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src"]
}
