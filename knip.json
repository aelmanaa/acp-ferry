{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "packages/spec": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/broker": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts",
        "test/support/fake-acp-agent.ts",
        "examples/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
    }
  }
}
